<!--
  Example environment for mujoco_robotsimulator_crospi.
  The robot (URDF) is attached to the world of this scene at base_position / base_quaternion_xyzw.
  The physics options (timestep, gravity, integrator, contacts) of this file are overwritten by the
  crospi configuration of the simulator.
-->
<mujoco model="table_with_box">
  <compiler angle="radian"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>

    <!-- Table next to the robot (negative y side), top surface at z = 0.4 m -->
    <body name="table" pos="0.3 -1.0 0.2">
      <geom name="table_top" type="box" size="0.3 0.5 0.2" rgba="0.55 0.4 0.3 1"/>
      <!-- Volume of the touch sensor: contacts on the top surface of the table -->
      <site name="table_top_surface" type="box" pos="0 0 0.2" size="0.3 0.5 0.01" rgba="0 0 0 0" group="4"/>
    </body>

    <!-- Free box lying on the table -->
    <body name="box" pos="0.3 -0.8 0.45">
      <freejoint name="box_joint"/>
      <geom name="box" type="box" size="0.05 0.05 0.05" mass="0.5" rgba="0.8 0.2 0.2 1"/>
    </body>
  </worldbody>

  <!-- MuJoCo sensors: published by the simulator on <topic_namespace>/mujoco_sensors/<name> -->
  <sensor>
    <framepos name="box_position" objtype="body" objname="box"/>
    <framequat name="box_orientation" objtype="body" objname="box"/>
    <touch name="table_top_touch" site="table_top_surface"/>
  </sensor>
</mujoco>
