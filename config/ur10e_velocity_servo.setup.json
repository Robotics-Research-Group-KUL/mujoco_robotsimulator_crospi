{
    "blackboard": {
        "etasl": {
            "general": {
                "event_topic": "crospi_node/events",
                "sample_time": 0.01
            },
            "initializer": {
                "full": true,
                "sample_time": 0.01,
                "duration": 3.0,
                "convergence_criterion": 1e-08,
                "weightfactor": 10000.0
            },
            "solver": {
                "is-qpoasessolver": true,
                "nWSR": 100,
                "regularization_factor": 1e-08,
                "cputime": 10
            }
        },
        "robot": {
            "robotsimulators": [
                {
                    "is-mujoco_robotsimulator_crospi": true,
                    "robot_joints": ["shoulder_pan_joint", "shoulder_lift_joint", "elbow_joint", "wrist_1_joint", "wrist_2_joint", "wrist_3_joint"],
                    "initial_joints": [0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
                    "periodicity": 0.01,
                    "urdf_path": "$[mujoco_robotsimulator_crospi]/config/urdf/ur10e_cylinder_tool.urdf",
                    "base_position": [0.0, 0.0, 0.0],
                    "base_quaternion_xyzw": [0.0, 0.0, 0.0, 1.0],
                    "add_ground_plane": true,
                    "simulation_timestep": 0.001,
                    "integrator": "implicitfast",
                    "gravity": [0.0, 0.0, -9.81],
                    "contacts_enabled": true,
                    "joint_armature": [0.5, 0.5, 0.3, 0.1, 0.1, 0.1],
                    "control_mode": "velocity_servo",
                    "joint_damping_gains": [500.0, 500.0, 250.0, 50.0, 50.0, 50.0],
                    "gravity_compensation": true,
                    "clamp_torques_to_effort_limits": true,
                    "name_expr_joint_vel": "joint_vel",
                    "name_expr_joint_torque": "joint_torque",
                    "ros_node_name": "mujoco_robotsimulator",
                    "sensor_publishing": {
                        "topic_namespace": "/mujoco_sim/sensors",
                        "publish_period": 0.01
                    }
                }
            ],
            "default_robot_specification": {
                "is-inline_robotspecification": true,
                "urdf_path": "$[mujoco_robotsimulator_crospi]/config/urdf/ur10e_cylinder_tool.urdf",
                "tcp_frame": {
                    "child_link": "tool0",
                    "parent_link": "base_link"
                },
                "robot_joints": ["shoulder_pan_joint", "shoulder_lift_joint", "elbow_joint", "wrist_1_joint", "wrist_2_joint", "wrist_3_joint"]
            }
        },
        "iohandlers": {
            "outputhandlers": [
                {
                    "is-JointStateOutputHandler": true,
                    "topic-name": "/joint_states"
                }
            ],
            "inputhandlers": []
        }
    },
    "$defs": {}
}
